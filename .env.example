# Copier ce fichier en `.env.local` et adapter les valeurs.
# ATTENTION : toute variable préfixée par VITE_ est incluse dans le code
# envoyé au navigateur. N'y mettez JAMAIS de secret (clé privée, mot de passe…).

VITE_APP_NAME=OPEM
VITE_API_URL=/api

# API REST WordPress (avec le plugin wordpress/opem-menu-api.php installé).
# Laisser vide pour utiliser le menu intégré (src/app/layouts/navbar/menu.ts).
# Si WordPress est sur un autre domaine, l'ajouter à `connect-src` dans la CSP.
VITE_WP_API_URL=
