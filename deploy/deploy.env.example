# Réglages de deploy/deploy.sh. Copier ce fichier en « deploy/deploy.env » (ignoré par Git)
# et remplacer les valeurs. Aucun mot de passe ici : la connexion se fait par clé SSH.

# Utilisateur et adresse du VPS (adresse IP ou nom), comme pour « ssh opem@… ».
DEPLOY_HOST=opem@203.0.113.10

# Adresse définitive du site (sans barre finale) : plan du site, aperçus de liens.
SITE_URL=https://opem-dz.com

# API de WordPress, lue par le site (formulaires, menu, citation du mois).
VITE_WP_API_URL=https://opem-dz.com/cms/wp-json

# Facultatif : dossier du site sur le serveur, et nombre de versions gardées.
# DEPLOY_DIR=/var/www/opem/site
# KEEP=5
